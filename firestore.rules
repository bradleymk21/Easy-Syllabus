rules_version = '2';

// Easy-Syllabus shared teaching trackers.
//
// Access model: a tracker's document ID *is* its share code, generated with
// ~74 bits of randomness. Anyone holding the code may read and write that one
// document; nobody may enumerate codes. There is no sign-in and no personal
// data is stored — only a tracker name and which syllabus content was ticked.

service cloud.firestore {
  match /databases/{database}/documents {
    match /trackers/{code} {

      // Fetch by exact ID only. `list` stays denied — without that, share codes
      // could be enumerated and the whole access model would collapse.
      allow get:  if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
                    && validShape()
                    && request.resource.data.name.size() <= 120;

      allow update: if request.auth != null
                    && validShape()
                    // Normal unticking is fine; a mass wipe is not.
                    && request.resource.data.fa.size() >= resource.data.fa.size() - 50
                    && request.resource.data.pt.size() >= resource.data.pt.size() - 200;

      // Trackers are left locally, never deleted from the client.
      allow delete: if false;

      function validShape() {
        return request.resource.data.keys().hasOnly(['name','created','updated','fa','pt'])
               && request.resource.data.name is string
               && request.resource.data.fa is map
               && request.resource.data.pt is map;
      }
    }
  }
}
